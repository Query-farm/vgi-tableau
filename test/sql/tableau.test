# ------------------------------------------------------------- unified.runs

query TTTTTTR
SELECT orchestrator, run_id, pipeline, status, raw_status, ended_at, duration_seconds FROM tableau.unified.runs ORDER BY run_id;
----
tableau	fr-1	Clean Orders	success	Success	2026-11-14 04:10:00+00	600.0
tableau	fr-2	Lead Scoring	failed	Failed	2026-11-13 05:02:00+00	120.0
tableau	fr-3	Lead Scoring	success	Success	2026-11-14 05:05:00+00	300.0
tableau	job-1	Orders	success	Success	2026-11-14 02:03:05+00	180.0
tableau	job-2	Headcount	failed	Failed	2026-11-14 03:01:10+00	60.0
tableau	job-3	Q3 Results	failed	Failed	2026-11-13 02:10:30+00	600.0
tableau	job-5	Orders	running	InProgress	NULL	NULL
tableau	job-7	Headcount	queued	Pending	NULL	NULL

query TT
SELECT run_id, url FROM tableau.unified.runs WHERE status IN ('failed', 'queued') ORDER BY run_id;
----
fr-2	https://acme.example/#/site/acme/flows/302
job-2	NULL
job-3	NULL
job-7	NULL

query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/jobs') WHERE query LIKE '%jobType:in:[refresh_extracts,increment_extracts],status:in:[Failed,Pending]%' AND query LIKE '%"pageNumber": "1"%';
----
1

# The shared orchestrator shape: exactly these columns, in this order.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM tableau.unified.runs);
----
orchestrator	VARCHAR
run_id	VARCHAR
pipeline	VARCHAR
status	VARCHAR
raw_status	VARCHAR
trigger	VARCHAR
queued_at	TIMESTAMP WITH TIME ZONE
started_at	TIMESTAMP WITH TIME ZONE
ended_at	TIMESTAMP WITH TIME ZONE
duration_seconds	DOUBLE
url	VARCHAR

# ------------------------------------------------ session expiry → re-sign-in

# The replay server expires its first session token after three calls; the
# worker signed in again and carried on.
query I
SELECT count(*) >= 2 FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/auth/signin') WHERE auth = 'pat';
----
true

# ------------------------------------------------- connected app, API version

statement ok
DROP SECRET tableau_fixture;

statement ok
CREATE SECRET tableau_app (TYPE tableau, SERVER_URL '{TABLEAU_FIXTURE_URL}', SITE_CONTENT_URL 'acme', CLIENT_ID 'client-id-1', SECRET_ID 'secret-id-1', SECRET_VALUE 'test-connected-app-secret-value', USERNAME 'grace@example.com', API_VERSION '3.20');

query I
SELECT count(*) FROM tableau.main.groups;
----
3

query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/auth/signin') WHERE auth = 'jwt' AND version = '3.20';
----
1

query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/groups') WHERE version = '3.20';
----
1

statement ok
DROP SECRET tableau_app;

statement ok
CREATE SECRET tableau_app_bad (TYPE tableau, SERVER_URL '{TABLEAU_FIXTURE_URL}', SITE_CONTENT_URL 'acme', CLIENT_ID 'client-id-1', SECRET_ID 'secret-id-1', SECRET_VALUE 'not-the-secret', USERNAME 'grace@example.com');

statement error
SELECT count(*) FROM tableau.main.groups;
----
<REGEX>:.*HTTP 401.*JWT signature invalid.*

statement ok
DROP SECRET tableau_app_bad;

statement ok
CREATE SECRET tableau_app_write (TYPE tableau, SERVER_URL '{TABLEAU_FIXTURE_URL}', SITE_CONTENT_URL 'acme', CLIENT_ID 'client-id-1', SECRET_ID 'secret-id-1', SECRET_VALUE 'test-connected-app-secret-value', USERNAME 'grace@example.com', SCOPES 'tableau:content:read tableau:content:write');

statement error
SELECT count(*) FROM tableau.main.groups;
----
<REGEX>:.*HTTP 401.*read-only.*

statement ok
DROP SECRET tableau_app_write;
