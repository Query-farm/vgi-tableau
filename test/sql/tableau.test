# name: test/sql/tableau.test
# description: SQL tests for the tableau worker against the offline Tableau replay server (test/mock_api/server.py)
# group: [tableau]

require vgi

require-env TABLEAU_WORKER

require-env TABLEAU_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'tableau' (TYPE vgi, LOCATION '{TABLEAU_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM tableau.main.workbooks;
----
<REGEX>:.*no tableau secret.*

statement ok
CREATE SECRET tableau_bad (TYPE tableau, SERVER_URL '{TABLEAU_FIXTURE_URL}', SITE_CONTENT_URL 'acme', PAT_NAME 'vgi-test', PAT_SECRET 'wrong');

statement error
SELECT count(*) FROM tableau.main.workbooks;
----
<REGEX>:.*sign-in failed with HTTP 401.*401001.*

statement ok
DROP SECRET tableau_bad;

statement ok
CREATE SECRET tableau_wrong_site (TYPE tableau, SERVER_URL '{TABLEAU_FIXTURE_URL}', SITE_CONTENT_URL 'other', PAT_NAME 'vgi-test', PAT_SECRET 'test-pat-secret');

statement error
SELECT count(*) FROM tableau.main.workbooks;
----
<REGEX>:.*HTTP 401.*site not found.*

statement ok
DROP SECRET tableau_wrong_site;

statement ok
CREATE SECRET tableau_insecure (TYPE tableau, SERVER_URL 'http://tableau.example.com', PAT_NAME 'x', PAT_SECRET 'y');

statement error
SELECT count(*) FROM tableau.main.workbooks;
----
<REGEX>:.*https.*

statement ok
DROP SECRET tableau_insecure;

statement ok
CREATE SECRET tableau_nocred (TYPE tableau, SERVER_URL '{TABLEAU_FIXTURE_URL}', SITE_CONTENT_URL 'acme');

statement error
SELECT count(*) FROM tableau.main.workbooks;
----
<REGEX>:.*PAT_NAME \+ PAT_SECRET.*

statement ok
DROP SECRET tableau_nocred;

# A small page size so every list pages several times.
statement ok
CREATE SECRET tableau_fixture (TYPE tableau, SERVER_URL '{TABLEAU_FIXTURE_URL}', SITE_CONTENT_URL 'acme', PAT_NAME 'vgi-test', PAT_SECRET 'test-pat-secret', PAGE_SIZE '2');

# ------------------------------------------------------------ sites, workbooks

query TTTT
SELECT name, content_url, state, revision_history_enabled FROM tableau.main.sites;
----
Acme Analytics	acme	Active	true

query TTTTITT
SELECT id, name, folder_path, owner, size_mb, url, tags FROM tableau.main.workbooks ORDER BY id;
----
wb-campaigns	Campaign Performance	Marketing	grace@example.com	30	https://acme.example/#/site/acme/workbooks/103	[marketing]
wb-q3	Q3 Results	Finance/Quarterly	grace@example.com	4	https://acme.example/#/site/acme/workbooks/102	[]
wb-sales	Sales Overview	Finance	ada@example.com	12	https://acme.example/#/site/acme/workbooks/101	[finance, certified]
wb-scratch	Scratchpad	Sandbox	alan@example.com	1	https://acme.example/#/site/acme/workbooks/104	[]

# The API version was discovered from serverinfo and every page was requested.
query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/workbooks') WHERE version = '3.24' AND query LIKE '%"pageSize": "2"%';
----
2

# Pushdown: a time bound (widened down to the whole second, so Tableau also returns
# Scratchpad, updated at 09:00:00 exactly) and a name IN list. The SDK re-applies the
# exact predicate, so Scratchpad is dropped again.
query T
SELECT name FROM tableau.main.workbooks WHERE updated_at >= TIMESTAMPTZ '2026-01-10 09:00:00.250+00' AND name IN ('Scratchpad', 'Q3 Results', 'Sales Overview') ORDER BY name;
----
Sales Overview

query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/workbooks') WHERE query LIKE '%updatedAt:gte:2026-01-10T09:00:00Z,name:in:[Scratchpad,Q3 Results,Sales Overview]%';
----
1

# ------------------------------------------------------------ dashboards/charts

query TTTTTITT
SELECT tool, id, title, folder_path, owner, view_count, url, sheet_type FROM tableau.main.dashboards ORDER BY id;
----
tableau	v-camp-dash	Campaign Dashboard	Marketing	grace@example.com	980	{TABLEAU_FIXTURE_URL}/#/site/acme/views/CampaignPerformance/CampaignDashboard	dashboard
tableau	v-q3-dash	Q3 Summary	Finance/Quarterly	grace@example.com	410	{TABLEAU_FIXTURE_URL}/#/site/acme/views/Q3Results/Q3Summary	dashboard
tableau	v-q3-story	Q3 Story	Finance/Quarterly	grace@example.com	75	{TABLEAU_FIXTURE_URL}/#/site/acme/views/Q3Results/Q3Story	story
tableau	v-sales-dash	Sales Dashboard	Finance	ada@example.com	1520	{TABLEAU_FIXTURE_URL}/#/site/acme/views/SalesOverview/SalesDashboard	dashboard

query TTI
SELECT title, workbook_name, view_count FROM tableau.main.charts WHERE workbook_name = 'Sales Overview' ORDER BY title;
----
Monthly Trend	Sales Overview	0
Sales by Region	Sales Overview	340

query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/views') WHERE query LIKE '%workbookName:eq:Sales Overview%' AND query LIKE '%includeUsageStatistics%';
----
2

query TTT
SELECT title, created_at, last_viewed_at FROM tableau.main.charts WHERE view_count = 0 ORDER BY title;
----
Funnel	2024-05-05 09:00:00+00	NULL
Monthly Trend	2025-03-01 09:00:00+00	NULL

# Top-N: DuckDB's ORDER BY … LIMIT hint becomes Tableau's sort.
query TI
SELECT title, view_count FROM tableau.main.content_usage ORDER BY view_count DESC LIMIT 2;
----
Sales Dashboard	1520
Campaign Dashboard	980

query I
SELECT count(*) > 0 FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/views') WHERE query LIKE '%"sort": "hitsTotal:desc"%';
----
true

query TII
SELECT workbook_name, count(*), sum(view_count) FROM tableau.main.content_usage GROUP BY ALL ORDER BY 1;
----
Campaign Performance	2	980
Q3 Results	3	497
Sales Overview	3	1860
Scratchpad	1	3

# The BI vocabulary columns UNION across tables.
query TI
SELECT tool, count(*) FROM (SELECT tool, id, title, folder_path, owner, created_at, updated_at, last_viewed_at, view_count, url FROM tableau.main.dashboards UNION ALL SELECT tool, id, title, folder_path, owner, created_at, updated_at, last_viewed_at, view_count, url FROM tableau.main.charts UNION ALL SELECT tool, id, title, folder_path, owner, created_at, updated_at, last_viewed_at, view_count, url FROM tableau.main.data_sources) GROUP BY tool;
----
tableau	12

