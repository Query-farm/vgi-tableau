query TTTTTTT
SELECT content_type, content_id, content_name, connection_type, server_address, username, embed_password FROM tableau.main.connections ORDER BY content_type, content_id;
----
datasource	ds-campaigns	Campaign Events	postgres	pg.internal	analyst	false
datasource	ds-hr	Headcount	sqlserver	hr-sql.internal	hr_reader	true
datasource	ds-orders	Orders	snowflake	acme.snowflakecomputing.com	TABLEAU_SVC	true
workbook	wb-campaigns	Campaign Performance	sqlproxy	acme.example	NULL	false
workbook	wb-q3	Q3 Results	snowflake	acme.snowflakecomputing.com	Q3_READER	false
workbook	wb-sales	Sales Overview	sqlproxy	acme.example	NULL	false
workbook	wb-scratch	Scratchpad	excel-direct	NULL	NULL	false

# No column ever carries a password.
query I
SELECT count(*) FROM tableau.main.connections c WHERE CAST(c AS VARCHAR) LIKE '%hunter2%';
----
0

query TT
SELECT content_name, username FROM tableau.main.connections WHERE content_id = 'ds-hr' AND content_type = 'datasource';
----
Headcount	hr_reader

# content_type = 'datasource' with a pushed id: one call, no workbook lookup.
query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/workbooks/ds-hr/connections');
----
0

# Two full scans above plus this pushed one.
query I
SELECT count(*) FROM read_json('{TABLEAU_FIXTURE_URL}/__requests?route=/datasources/ds-hr/connections');
----
3

